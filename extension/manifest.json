{
  "manifest_version": 3,
  "name": "Visual Bookmarks StabilityInternational",
  "version": "2.2.0",
  "description": "Визуальные закладки Stability International: сетка, фон, синхронизация с Crypt-Chain.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "315927633254-knl0p5tu8uu0kli79pe6c3154tuahctb.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.readonly"]
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Visual Bookmarks StabilityInternational"
  }
}
